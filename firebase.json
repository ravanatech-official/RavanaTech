{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "server.js",
      "package.json",
      "package-lock.json",
      "bun.lock"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/projects",
        "destination": "/projects.html"
      }
    ]
  }
}
